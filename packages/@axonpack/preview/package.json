{
  "name": "@axonpack/preview",
  "version": "0.0.0",
  "description": "Download and switch between preview JS bundles of an Expo app without a native rebuild",
  "author": "Md Asadujjaman <abappi2019@gmail.com> (https://github.com/abappi19)",
  "keywords": [
    "preview",
    "ota",
    "bundle",
    "qa",
    "expo",
    "react-native"
  ],
  "bugs": {
    "url": "https://github.com/axonpack/axonpack/issues"
  },
  "license": "MIT",
  "homepage": "https://axonpack.dev/docs/preview/",
  "repository": {
    "type": "git",
    "url": "https://github.com/axonpack/axonpack.git",
    "directory": "packages/@axonpack/preview"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "android",
    "ios",
    "bin",
    "build",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md",
    "notes"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "preview": "bin/preview.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf build && tsc && bun build src/cli/main.ts --target=node --format=cjs --outfile=build/cli.cjs",
    "prepare": "bun run build",
    "clean": "rm -rf build",
    "lint": "oxlint src",
    "format": "oxlint src --fix",
    "test": "jest",
    "check-types": "tsc --noEmit -p tsconfig.check.json",
    "storage:local": "./local-s3/run.sh start",
    "storage:local:stop": "./local-s3/run.sh stop",
    "storage:local:reset": "./local-s3/run.sh reset"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@types/jest": "^29.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "expo": "^57.0.7",
    "expo-file-system": "~58.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "linter": "*",
    "oxlint": "^1.80.0",
    "react": "19.3.0",
    "react-native": "0.86.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": ">=53",
    "react": ">=18",
    "react-native": ">=0.79",
    "expo-file-system": "*"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*(react-native|expo|@noble))"
    ],
    "moduleNameMapper": {
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
