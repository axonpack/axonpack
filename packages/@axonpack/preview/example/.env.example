# The app's settings, read when the app is bundled (copy to .env). Expo builds every EXPO_PUBLIC_*
# value into the app, so only a read-only key may go here, never the write key.

# Required: <endpoint>/<bucket>[/<folder>]. Public bucket of the local MinIO:
EXPO_PUBLIC_PREVIEW_S3_URL=http://localhost:9000/previews-public

# Private bucket instead: use its URL and the read-only key (local MinIO test values).
# EXPO_PUBLIC_PREVIEW_S3_URL=http://localhost:9000/previews-private
# EXPO_PUBLIC_PREVIEW_S3_READ_ACCESS_KEY_ID=preview-reader
# EXPO_PUBLIC_PREVIEW_S3_READ_SECRET_ACCESS_KEY=preview-reader-secret

# Optional signing region, default us-east-1 (MinIO and R2 accept it); change it for an AWS bucket in another region.
EXPO_PUBLIC_PREVIEW_S3_REGION=us-east-1

# Public bucket served from another address than <endpoint>/<bucket>, such as R2's r2.dev domain.
# EXPO_PUBLIC_PREVIEW_S3_PUBLIC_URL=https://pub-<id>.r2.dev

# Headers for a tunnel or proxy in front of the bucket are not env: pass the `headers` option in
# the app's config (see App.tsx and notes/storage.md).
