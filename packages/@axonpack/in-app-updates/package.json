{
  "name": "@axonpack/in-app-updates",
  "version": "0.1.1",
  "description": "Store version check, force updates and update prompts for React Native and Expo",
  "author": "Md Asadujjaman <abappi2019@gmail.com> (https://github.com/abappi19)",
  "keywords": [
    "version-check",
    "force-update",
    "app-store",
    "play-store",
    "expo",
    "react-native"
  ],
  "bugs": {
    "url": "https://github.com/axonpack/axonpack/issues"
  },
  "license": "MIT",
  "homepage": "https://axonpack.dev/docs/in-app-updates/",
  "repository": {
    "type": "git",
    "url": "https://github.com/axonpack/axonpack.git",
    "directory": "packages/@axonpack/in-app-updates"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "android",
    "build",
    "expo-module.config.json",
    "CHANGELOG.md",
    "notes"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf build && tsc",
    "prepare": "bun run build",
    "clean": "rm -rf build",
    "lint": "oxlint src",
    "format": "oxlint src --fix",
    "test": "jest",
    "check-types": "tsc --noEmit -p tsconfig.check.json"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.4",
    "@types/jest": "^29.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "expo": "^57.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "linter": "*",
    "oxlint": "^1.80.0",
    "react": "19.3.0",
    "react-native": "0.86.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo-application": ">=5",
    "expo-localization": ">=14",
    "react": ">=18",
    "react-native": ">=0.72",
    "expo": ">=52"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*(react-native|expo))"
    ],
    "moduleNameMapper": {
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    }
  }
}
