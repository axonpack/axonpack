# Where `preview-ready publish` uploads previews. Copy to .env (gitignored) and fill in.
# These values are the local MinIO from `bun run storage:local` in the package: test values only.
PREVIEW_READY_S3_ENDPOINT=http://localhost:9000
PREVIEW_READY_S3_BUCKET=previews-public
PREVIEW_READY_S3_REGION=us-east-1
PREVIEW_READY_S3_ACCESS_KEY_ID=preview-ready-admin
PREVIEW_READY_S3_SECRET_ACCESS_KEY=preview-ready-admin-secret
# Only when public reads go somewhere else than <endpoint>/<bucket>, such as R2's r2.dev address.
# PREVIEW_READY_S3_PUBLIC_URL=
