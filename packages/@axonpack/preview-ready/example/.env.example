# Publishing (`npx preview-ready publish`): the local MinIO from `bun run storage:local` (test values).
PREVIEW_READY_S3_URL=http://localhost:9000/previews-public
PREVIEW_READY_S3_ACCESS_KEY_ID=preview-ready-admin
PREVIEW_READY_S3_SECRET_ACCESS_KEY=preview-ready-admin-secret
# The app. EXPO_PUBLIC_* is built into the app: only a read-only key may go here, never the write key.
EXPO_PUBLIC_PREVIEW_READY_S3_URL=http://localhost:9000/previews-public
