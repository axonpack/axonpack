# Publishing (`npx preview-ready publish`), read by nothing else (copy to .env.preview-ready, which
# is gitignored). Real environment variables win over this file, for CI.

# Required: <endpoint>/<bucket>[/<folder>], and the write key. Local MinIO test values:
PREVIEW_READY_S3_URL=http://localhost:9000/previews-public
PREVIEW_READY_S3_ACCESS_KEY_ID=preview-ready-admin
PREVIEW_READY_S3_SECRET_ACCESS_KEY=preview-ready-admin-secret

# The private bucket instead (same write key):
# PREVIEW_READY_S3_URL=http://localhost:9000/previews-private

# Signing region. Default us-east-1, which MinIO and R2 accept; set it for an AWS bucket in another
# region, or "auto" for R2.
# PREVIEW_READY_S3_REGION=us-east-1

# Where public reads go when that is not <endpoint>/<bucket>, such as R2's r2.dev domain. Only
# printed by the CLI, as the address to give the app.
# PREVIEW_READY_S3_PUBLIC_URL=https://pub-<id>.r2.dev
