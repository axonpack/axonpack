# Local test values only. Nothing here is a real secret, and none of it may be used outside your
# own machine. The compose file, init.sh and the no-Docker steps in notes/storage.md all read this
# one file, so the names can't drift apart.
LOCAL_S3_PORT=9000
LOCAL_S3_REGION=us-east-1
MINIO_ROOT_USER=preview-ready-admin
MINIO_ROOT_PASSWORD=preview-ready-admin-secret
LOCAL_S3_PUBLIC_BUCKET=previews-public
LOCAL_S3_PRIVATE_BUCKET=previews-private
LOCAL_S3_READ_KEY=preview-ready-reader
LOCAL_S3_READ_SECRET=preview-ready-reader-secret
