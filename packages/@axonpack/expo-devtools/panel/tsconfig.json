{
  "compilerOptions": {
    "lib": ["dom", "DOM.Iterable", "esnext"],
    "types": [],
    "target": "esnext",
    "moduleResolution": "bundler",
    "module": "esnext",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true
  },
  "include": ["src", "rsbuild.config.ts"]
}
