{
  "name": "@axonpack/expo-devtools",
  "version": "2.4.0",
  "description": "Development Debugging tool for React Native",
  "author": "Md Asadujjaman <abappi2019@gmail.com> (https://github.com/abappi19)",
  "keywords": [
    "devtools",
    "Devtool",
    "react",
    "expo",
    "react-native"
  ],
  "homepage": "https://github.com/axonpack/axonpack#readme",
  "bugs": {
    "url": "https://github.com/axonpack/axonpack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axonpack/axonpack.git",
    "directory": "packages/@axonpack/expo-devtools"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "build",
    "ios",
    "android",
    "expo-module.config.json",
    "REFERENCE.md",
    "notes"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "oxlint src",
    "format": "oxlint src --fix",
    "test": "node internal/module_scripts/test.js",
    "check-types": "tsc --noEmit",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "run:ios": "cd example && expo run:ios",
    "run:android": "cd example && expo run:android",
    "prepare": "EXPO_NONINTERACTIVE=1 node internal/module_scripts/build.js",
    "commit": "commit",
    "release": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "release:add": "changeset add",
    "release:status": "changeset status",
    "release:tag": "changeset tag"
  },
  "dependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@expo/vector-icons": "^15.1.1",
    "expo-clipboard": "~57.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.28.4",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~57.0.4",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "eslint-import-resolver-node": "^0.3.10",
    "expo": "^57.0.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "linter": "*",
    "oxlint": "^1.77.0",
    "prettier": "^3.0.0",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-webview": "^14.0.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*(react-native|expo))"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-webview": "*"
  }
}
